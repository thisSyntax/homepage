# Copy this file to .env and fill in real values.
# .env is gitignored - never commit it. See CLAUDE.md for the layout these
# variables feed into.

# --- Infrastructure: Proxmox nodes F-SI-HV01 + F-SI-HV02 (cluster API), Synology; Grafana graphs on all three ---
HOMEPAGE_VAR_PROXMOX_IP_URL=
HOMEPAGE_VAR_PROXMOX_API_ID=
HOMEPAGE_VAR_PROXMOX_API_KEY=
HOMEPAGE_VAR_GRAFANA_URL=
HOMEPAGE_VAR_SYNOLOGY_IP_URL=
HOMEPAGE_VAR_SYNOLOGY_USERNAME=
HOMEPAGE_VAR_SYNOLOGY_PASSWORD=

# --- Services > Apps: Tautulli (links to Plex), Immich, Home Assistant ---
HOMEPAGE_VAR_WEB_DOMAIN=
HOMEPAGE_VAR_TAUTULLI_API_KEY=
HOMEPAGE_VAR_IMMICH_TOKEN=
HOMEPAGE_VAR_HOMEASSISTANT_URL=
HOMEPAGE_VAR_HOMEASSISTANT_TOKEN=

# --- Services > Admin: Komodo, Grafana (link + health check), Prometheus ---
HOMEPAGE_VAR_KOMODO_IP_URL=
HOMEPAGE_VAR_KOMODO_API_KEY=
HOMEPAGE_VAR_KOMODO_SECRET=
HOMEPAGE_VAR_PROMETHEUS_URL=

# --- Services > Network: Unifi Controller, Speedtest-Tracker, Gluetun ---
# Gluetun: control server URL (e.g. http://<docker-media>:8000) and an API key
# that Gluetun's control server auth allows on GET /v1/publicip/ip
HOMEPAGE_VAR_GLUETUN_URL=
HOMEPAGE_VAR_GLUETUN_API_KEY=
HOMEPAGE_VAR_UNIFI_IP=
HOMEPAGE_VAR_UNIFI_USERNAME=
HOMEPAGE_VAR_UNIFI_PASSWORD=
HOMEPAGE_VAR_DOCKER-OTHERS_IP=
HOMEPAGE_VAR_SPEEDTEST_TRACKER_API_KEY=

# --- Services > DNS & Proxy: Pi-hole 1, Pi-hole 2, Traefik Internal ---
HOMEPAGE_VAR_PIHOLE1_IP=
HOMEPAGE_VAR_PIHOLE1_API_KEY=
HOMEPAGE_VAR_PIHOLE2_IP=
HOMEPAGE_VAR_PIHOLE2_API_KEY=
HOMEPAGE_VAR_ITRAEFIK_USER=
HOMEPAGE_VAR_ITRAEFIK_PASSWD=

# --- Media > Arr Stack: Radarr, Sonarr, Lidarr, Bazarr, Prowlarr ---
# Also used by Syncthing/Notifiarr (Management) and the Calendar/Agenda widgets.
HOMEPAGE_VAR_DOCKER-MEDIA_IP=
HOMEPAGE_VAR_RADARR_API_KEY=
HOMEPAGE_VAR_SONARR_API_KEY=
HOMEPAGE_VAR_LIDARR_API_KEY=
HOMEPAGE_VAR_BAZARR_API_KEY=
HOMEPAGE_VAR_PROWLARR_API_KEY=

# --- Media > Management: Seerr, Syncthing ---
HOMEPAGE_VAR_JELLYSEERR_API_KEY=
HOMEPAGE_VAR_SYNCTHING_API_KEY=

# --- widgets.yaml: openmeteo ---
HOMEPAGE_VAR_OPENMETEO_LATITUDE=
HOMEPAGE_VAR_OPENMETEO_LONGITUDE=
