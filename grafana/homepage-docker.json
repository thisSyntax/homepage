{
  "uid": "homepage-docker",
  "title": "Homepage - Docker",
  "description": "Docker hosts and containers (cAdvisor + node-exporter, one Prometheus job per host). Opened in kiosk mode from the SYS.MON button on Homepage.",
  "tags": [
    "homepage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      },
      {
        "name": "host",
        "label": "Host",
        "type": "custom",
        "query": "komodo,docker-essentials,docker-media,docker-others",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "description": "Fixed list so the dropdown and host bars share one order. Adding a Docker host means adding it here and to the Host CPU / memory / disk queries.",
        "options": [
          {
            "text": "komodo",
            "value": "komodo",
            "selected": false
          },
          {
            "text": "docker-essentials",
            "value": "docker-essentials",
            "selected": false
          },
          {
            "text": "docker-media",
            "value": "docker-media",
            "selected": false
          },
          {
            "text": "docker-others",
            "value": "docker-others",
            "selected": false
          }
        ]
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "description": "Containers on the selected hosts. Names repeat across hosts (cadvisor, node-exporter, ...), so picking one shows it on every selected host.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(container_memory_working_set_bytes{job=~\"$host\", name!=\"\"}, name)",
        "query": {
          "query": "label_values(container_memory_working_set_bytes{job=~\"$host\", name!=\"\"}, name)",
          "refId": "container"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Containers",
      "transparent": true,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (job, name) (container_memory_working_set_bytes{job=~\"$host\", name!=\"\"}))",
          "legendFormat": "Running"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#00e5ff"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Host CPU",
      "transparent": true,
      "gridPos": {
        "h": 6,
        "w": 7,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (job) (rate(node_cpu_seconds_total{job=\"komodo\", job=~\"$host\", mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "100 * (1 - avg by (job) (rate(node_cpu_seconds_total{job=\"docker-essentials\", job=~\"$host\", mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "100 * (1 - avg by (job) (rate(node_cpu_seconds_total{job=\"docker-media\", job=~\"$host\", mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "100 * (1 - avg by (job) (rate(node_cpu_seconds_total{job=\"docker-others\", job=~\"$host\", mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#00e5ff",
                "value": null
              },
              {
                "color": "#fcee0a",
                "value": 70
              },
              {
                "color": "#ff3b5c",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Host memory",
      "transparent": true,
      "gridPos": {
        "h": 6,
        "w": 7,
        "x": 11,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum by (job) (node_memory_MemAvailable_bytes{job=\"komodo\", job=~\"$host\"}) / sum by (job) (node_memory_MemTotal_bytes{job=\"komodo\", job=~\"$host\"}))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "100 * (1 - sum by (job) (node_memory_MemAvailable_bytes{job=\"docker-essentials\", job=~\"$host\"}) / sum by (job) (node_memory_MemTotal_bytes{job=\"docker-essentials\", job=~\"$host\"}))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "100 * (1 - sum by (job) (node_memory_MemAvailable_bytes{job=\"docker-media\", job=~\"$host\"}) / sum by (job) (node_memory_MemTotal_bytes{job=\"docker-media\", job=~\"$host\"}))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "100 * (1 - sum by (job) (node_memory_MemAvailable_bytes{job=\"docker-others\", job=~\"$host\"}) / sum by (job) (node_memory_MemTotal_bytes{job=\"docker-others\", job=~\"$host\"}))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#00e5ff",
                "value": null
              },
              {
                "color": "#fcee0a",
                "value": 80
              },
              {
                "color": "#ff3b5c",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Fullest disk",
      "description": "Fullest real filesystem (ext4/xfs/btrfs/zfs) node-exporter can see per host. Its own / is an overlay filesystem, which node-exporter skips by default.",
      "transparent": true,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max by (job) (1 - node_filesystem_avail_bytes{job=\"komodo\", job=~\"$host\", fstype=~\"ext4|xfs|btrfs|zfs\"} / node_filesystem_size_bytes{job=\"komodo\", job=~\"$host\", fstype=~\"ext4|xfs|btrfs|zfs\"})",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "100 * max by (job) (1 - node_filesystem_avail_bytes{job=\"docker-essentials\", job=~\"$host\", fstype=~\"ext4|xfs|btrfs|zfs\"} / node_filesystem_size_bytes{job=\"docker-essentials\", job=~\"$host\", fstype=~\"ext4|xfs|btrfs|zfs\"})",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "100 * max by (job) (1 - node_filesystem_avail_bytes{job=\"docker-media\", job=~\"$host\", fstype=~\"ext4|xfs|btrfs|zfs\"} / node_filesystem_size_bytes{job=\"docker-media\", job=~\"$host\", fstype=~\"ext4|xfs|btrfs|zfs\"})",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "100 * max by (job) (1 - node_filesystem_avail_bytes{job=\"docker-others\", job=~\"$host\", fstype=~\"ext4|xfs|btrfs|zfs\"} / node_filesystem_size_bytes{job=\"docker-others\", job=~\"$host\", fstype=~\"ext4|xfs|btrfs|zfs\"})",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#00e5ff",
                "value": null
              },
              {
                "color": "#fcee0a",
                "value": 80
              },
              {
                "color": "#ff3b5c",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
