{
  "uid": "homepage-docker",
  "title": "Homepage - Docker",
  "description": "Docker hosts and containers (cAdvisor + node-exporter, one Prometheus job per host). Opened in kiosk mode from the SYS.MON button on Homepage.",
  "tags": ["homepage"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(container_memory_working_set_bytes, job)",
        "query": { "query": "label_values(container_memory_working_set_bytes, job)", "refId": "host" },
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Containers",
      "transparent": true,
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (job, name) (container_memory_working_set_bytes{job=~\"$host\", name!=\"\"}))",
          "legendFormat": "Running"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#00e5ff" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Host CPU",
      "transparent": true,
      "gridPos": { "h": 6, "w": 7, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (job) (rate(node_cpu_seconds_total{job=~\"$host\", mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#00e5ff", "value": null },
              { "color": "#fcee0a", "value": 70 },
              { "color": "#ff3b5c", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Host memory",
      "transparent": true,
      "gridPos": { "h": 6, "w": 7, "x": 11, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum by (job) (node_memory_MemAvailable_bytes{job=~\"$host\"}) / sum by (job) (node_memory_MemTotal_bytes{job=~\"$host\"}))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#00e5ff", "value": null },
              { "color": "#fcee0a", "value": 80 },
              { "color": "#ff3b5c", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Host disk /",
      "description": "node-exporter runs in a container, so / is its overlay filesystem - which reports the size and free space of the disk holding Docker's data.",
      "transparent": true,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - max by (job) (node_filesystem_avail_bytes{job=~\"$host\", mountpoint=\"/\"}) / max by (job) (node_filesystem_size_bytes{job=~\"$host\", mountpoint=\"/\"}))",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#00e5ff", "value": null },
              { "color": "#fcee0a", "value": 80 },
              { "color": "#ff3b5c", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Top CPU (100% = one core)",
      "transparent": true,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, 100 * sum by (job, name) (rate(container_cpu_usage_seconds_total{job=~\"$host\", name!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{name}} · {{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#00e5ff", "value": null },
              { "color": "#fcee0a", "value": 50 },
              { "color": "#ff3b5c", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Top memory",
      "transparent": true,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (job, name) (container_memory_working_set_bytes{job=~\"$host\", name!=\"\"}))",
          "legendFormat": "{{name}} · {{job}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#00e5ff", "value": null },
              { "color": "#fcee0a", "value": 1073741824 },
              { "color": "#ff3b5c", "value": 2147483648 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU by container",
      "transparent": true,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (job, name) (rate(container_cpu_usage_seconds_total{job=~\"$host\", name!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{name}} · {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisPlacement": "right",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory by container",
      "transparent": true,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, name) (container_memory_working_set_bytes{job=~\"$host\", name!=\"\"})",
          "legendFormat": "{{name}} · {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "decimals": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisPlacement": "right",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Network in (top 10)",
      "description": "Containers using host networking don't show here - cAdvisor only sees per-container network namespaces.",
      "transparent": true,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, 8 * sum by (job, name) (rate(container_network_receive_bytes_total{job=~\"$host\", name!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{name}} · {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisPlacement": "right",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Network out (top 10)",
      "transparent": true,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, 8 * sum by (job, name) (rate(container_network_transmit_bytes_total{job=~\"$host\", name!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{name}} · {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "axisPlacement": "right",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Recently started",
      "description": "Containers with the shortest uptime - a container that keeps showing up here is crash-looping.",
      "transparent": true,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(10, time() - max by (job, name) (container_start_time_seconds{job=~\"$host\", name!=\"\"}))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "name": 0, "job": 1, "Value": 2 },
            "renameByName": { "name": "Container", "job": "Host", "Value": "Up for" }
          }
        },
        { "id": "sortBy", "options": { "sort": [{ "field": "Up for", "desc": false }] } }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Up for" },
            "properties": [
              { "id": "unit", "value": "dtdurations" },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#ff3b5c", "value": null },
                    { "color": "#fcee0a", "value": 3600 },
                    { "color": "#00e5ff", "value": 86400 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      }
    }
  ]
}
