    {
      "id": 11,
      "type": "table",
      "title": "Recently started",
      "description": "Containers with the shortest uptime - a container that keeps showing up here is crash-looping.",
      "transparent": true,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(10, time() - max by (job, name) (container_start_time_seconds{job=~\"$host\", name=~\"$container\"}))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "job": 1,
              "Value": 2
            },
            "renameByName": {
              "name": "Container",
              "job": "Host",
              "Value": "Up for"
